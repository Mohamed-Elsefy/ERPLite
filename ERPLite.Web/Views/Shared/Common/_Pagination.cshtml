@using ERPLite.Web.Models.Common
@model PaginationViewModel

@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var window = 2;
    var start = Math.Max(1, Model.PageNumber - window);
    var end = Math.Min(Model.TotalPages, Model.PageNumber + window);

    Dictionary<string, string> RouteFor(int page)
    {
        var route = new Dictionary<string, string>(Model.Filters)
        {
            ["page"] = page.ToString(),
            ["pageSize"] = Model.PageSize.ToString()
        };
        return route;
    }
}

@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 mt-4">
        <small class="text-muted font-monospace">
            Showing @Model.FirstItemIndex–@Model.LastItemIndex of @Model.TotalCount
        </small>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="@action" asp-all-route-data="@RouteFor(Model.PageNumber - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @if (start > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="@action" asp-all-route-data="@RouteFor(1)">1</a>
                        </li>
                        @if (start > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="@action" asp-all-route-data="@RouteFor(p)">@p</a>
                        </li>
                    }

                    @if (end < Model.TotalPages)
                    {
                        @if (end < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="@action" asp-all-route-data="@RouteFor(Model.TotalPages)">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="@action" asp-all-route-data="@RouteFor(Model.PageNumber + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
